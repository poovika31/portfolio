<script>
// Mobile menu
const menuBtn = document.getElementById("menuBtn");
const navLinks = document.getElementById("navLinks");

menuBtn.addEventListener("click", function () {
  const open = navLinks.classList.toggle("open");
  menuBtn.setAttribute("aria-expanded", String(open));
});

navLinks.querySelectorAll("a").forEach(function (link) {
  link.addEventListener("click", function () {
    navLinks.classList.remove("open");
    menuBtn.setAttribute("aria-expanded", "false");
  });
});

// Footer year
document.getElementById("year").textContent =
  new Date().getFullYear();

// Multiple certificate previews
const certificateInput = document.getElementById("certificateInput");
const certificateList = document.getElementById("certificateList");
const certificateCount = document.getElementById("certificateCount");
const clearCertificates = document.getElementById("clearCertificates");

const uploadedCertificates = new Map();

function updateCertificateCount() {
  certificateCount.textContent =
    "Newly selected certificates: " + uploadedCertificates.size;
}

certificateInput.addEventListener("change", function () {
  Array.from(this.files).forEach(function (file) {
    const isPDF =
      file.type === "application/pdf" ||
      file.name.toLowerCase().endsWith(".pdf");

    const isImage = file.type.startsWith("image/");

    if (!isPDF && !isImage) {
      alert("Please select PDF or image files.");
      return;
    }

    const key = file.name + "-" + file.size;

    if (uploadedCertificates.has(key)) return;

    const url = URL.createObjectURL(file);
    uploadedCertificates.set(key, url);

    const card = document.createElement("article");
    card.className = "certificate-card";

    const title = document.createElement("h3");
    title.textContent = file.name;
    card.appendChild(title);

    if (isImage) {
      const image = document.createElement("img");
      image.src = url;
      image.alt = file.name;
      card.appendChild(image);
    } else {
      const description = document.createElement("p");
      description.textContent = "📄 PDF Certificate";
      card.appendChild(description);
    }

    const link = document.createElement("a");
    link.href = url;
    link.target = "_blank";
    link.rel = "noopener noreferrer";
    link.textContent = "View Certificate";
    card.appendChild(link);

    certificateList.appendChild(card);
  });

  updateCertificateCount();
  this.value = "";
});

clearCertificates.addEventListener("click", function () {
  uploadedCertificates.forEach(function (url) {
    URL.revokeObjectURL(url);
  });

  uploadedCertificates.clear();
  certificateList.innerHTML = "";
  updateCertificateCount();
});

// Contact form: replace this placeholder with your email
document.getElementById("contactForm").addEventListener(
  "submit",
  function (event) {
    event.preventDefault();

    const name =
      document.getElementById("visitorName").value.trim();

    const email =
      document.getElementById("visitorEmail").value.trim();

    const message =
      document.getElementById("visitorMessage").value.trim();

    const subject = encodeURIComponent("Portfolio message from " + name);

    const body = encodeURIComponent(
      "Name: " + name +
      "\nEmail: " + email +
      "\n\n" + message
    );

    window.location.href =
      "mailto:YOUR_EMAIL@example.com?subject=" +
      subject + "&body=" + body;
  }
);
</script>

